#!/usr/bin/env bash

# Prepare local directories and verify the inference environment.
# Usage:
#   ./scripts/setup-vlm4vad
#   ./scripts/setup-vlm4vad --install
#   ./scripts/setup-vlm4vad --install --torch-variant cu121
#   ./scripts/setup-vlm4vad --check-only

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_common.sh
source "${SCRIPT_DIR}/_common.sh"

ROOT="$(vlm4vad_repo_root)"
CHECK_ONLY=0
DO_INSTALL=0
TORCH_VARIANT="${VLM4VAD_TORCH_VARIANT:-auto}"
TORCH_VERSION="${VLM4VAD_TORCH_VERSION:-2.4.1}"
TORCHVISION_VERSION="${VLM4VAD_TORCHVISION_VERSION:-0.19.1}"

usage() {
  cat <<'EOF'
Usage: setup-vlm4vad [--install] [--check-only] [--torch-variant auto|cpu|cu121]

Create project directories and verify Python dependencies for VLM4VAD.

Options:
  --install                 Install torch/torchvision then requirements.txt
  --check-only              Only verify the environment, do not create directories
  --torch-variant VARIANT   auto (default), cpu, or cu121; or set VLM4VAD_TORCH_VARIANT
  -h, --help                Show this help

Environment:
  VLM4VAD_TORCH_VARIANT           auto | cpu | cu121
  VLM4VAD_TORCH_VERSION           default 2.4.1
  VLM4VAD_TORCHVISION_VERSION     default 0.19.1
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check-only)
      CHECK_ONLY=1
      shift
      ;;
    --install)
      DO_INSTALL=1
      shift
      ;;
    --torch-variant)
      TORCH_VARIANT="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      vlm4vad_error "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

cd "${ROOT}"

if [[ "${CHECK_ONLY}" -eq 0 ]]; then
  vlm4vad_info "Creating project directories under ${ROOT}"
  vlm4vad_ensure_dirs "${ROOT}"
  chmod +x \
    "${ROOT}/scripts/setup-vlm4vad" \
    "${ROOT}/scripts/detect-vlm4vad" \
    "${ROOT}/scripts/check-vlm4vad" \
    "${ROOT}/scripts/install-path.sh" \
    "${ROOT}/scripts/env_setup.sh" \
    2>/dev/null || true
fi

vlm4vad_require_cmd python

install_torch() {
  local index_url=""
  local resolved_variant="${TORCH_VARIANT}"

  if [[ "${resolved_variant}" == "auto" ]]; then
    if command -v nvidia-smi >/dev/null 2>&1; then
      resolved_variant="cu121"
    else
      resolved_variant="cpu"
    fi
  fi

  TORCH_VARIANT="${resolved_variant}"

  case "${TORCH_VARIANT}" in
    cpu)
      index_url="https://download.pytorch.org/whl/cpu"
      ;;
    cu121)
      index_url="https://download.pytorch.org/whl/cu121"
      ;;
    *)
      vlm4vad_error "Unsupported torch variant: ${TORCH_VARIANT} (use auto, cpu, or cu121)"
      exit 1
      ;;
  esac

  vlm4vad_info "Installing torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} (${TORCH_VARIANT})"
  python -m pip install --upgrade pip setuptools wheel
  python -m pip install \
    "torch==${TORCH_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}" \
    --index-url "${index_url}"
}

if [[ "${DO_INSTALL}" -eq 1 ]]; then
  install_torch
  vlm4vad_info "Installing requirements.txt (no torch; already handled)"
  python -m pip install -r "${ROOT}/requirements.txt"
fi

vlm4vad_info "Checking Python packages"
if ! python - <<'PY'
import importlib
import shutil
import sys

required = [
    "cv2",
    "numpy",
    "PIL",
    "torch",
    "torchvision",
    "yaml",
    "tqdm",
    "ftfy",
    "regex",
    "scipy",
]

missing = []
for name in required:
    try:
        importlib.import_module(name)
    except Exception:
        missing.append(name)

if missing:
    print("Missing packages: " + ", ".join(missing), file=sys.stderr)
    print("Install with: ./scripts/setup-vlm4vad --install", file=sys.stderr)
    raise SystemExit(1)

import torch
print(f"torch={torch.__version__} cuda={torch.cuda.is_available()}")

if shutil.which("nvidia-smi") and not torch.cuda.is_available():
    print(
        "WARN: NVIDIA GPU is visible but current torch build has CUDA disabled. "
        "Reinstall with: ./scripts/setup-vlm4vad --install --torch-variant cu121",
        file=sys.stderr,
    )
PY
then
  exit 1
fi

vlm4vad_info "Environment is ready"
vlm4vad_info "Put videos in: ${ROOT}/data/videos"
vlm4vad_info "Put checkpoint in: ${ROOT}/checkpoints/model_xd.pth"
