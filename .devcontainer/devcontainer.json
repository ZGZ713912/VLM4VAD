{
  "name": "VLM4VAD",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/scripts:/home/vscode/.local/bin:${containerEnv:PATH}",
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    "VLM4VAD_PATH": "${containerWorkspaceFolder}"
  },
  "runArgs": [
    "--ipc=host",
    "--shm-size=16g"
  ],
  "containerEnv": {
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "VLM4VAD_TORCH_VARIANT": "auto",
    "VLM4VAD_TORCH_VERSION": "2.4.1",
    "VLM4VAD_TORCHVISION_VERSION": "0.19.1",
    "VLM4VAD_CLIP_CACHE": "${containerWorkspaceFolder}/.cache/clip"
  },
  "mounts": [
    "source=vlm4vad-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=vlm4vad-clip-cache,target=/home/vscode/.cache/clip,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": [
          "${containerWorkspaceFolder}/src"
        ],
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash scripts/install-path.sh && mkdir -p outputs data/videos data/datasets checkpoints experiments"
}
